# Пример конфигурации (скопируйте в .env и заполните секреты)

APP_SECRET_KEY=
# Опционально: отдельный ключ шифрования aws_secret_access_key в БД
# APP_SECRETS_KEY=
APP_ADMIN_PASSWORD=

# Локальный HTTP: Secure cookie иначе браузер не сохранит сессию
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax
# APP_TRUST_PROXY=true

# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW_SECONDS=300
# METRICS_RATE_LIMIT=60
# METRICS_RATE_WINDOW_SECONDS=60

# Публичный URL UI (prod)
APP_EXTERNAL_URL=https://s3fm.example.com

# SSO / Keycloak (idp.example.com)
# В Docker-образе CA  уже вшиты (crt/ → REQUESTS_CA_BUNDLE).
# Локально без Docker, если SSL к IdP падает:
# REQUESTS_CA_BUNDLE=/path/to/crt/bundle.pem
SSO_ENABLED=true
OIDC_ISSUER=https://idp.example.com/realms/internal
OIDC_CLIENT_ID=s3fm
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://s3fm.example.com/api/auth/sso/callback
# SSO_FEDERATED_LOGOUT=true
# SSO_POST_LOGOUT_REDIRECT_URI=https://s3fm.example.com/
SSO_AUTO_PROVISION=true
SSO_DEFAULT_ROLE=storage_viewer
# SSO_ONLY=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# LDAP / AD lookup (Настройки → Пользователи → добавить / копировать)
# Обязательны для включения: LDAP_URI, LDAP_BASE_DN, LDAP_BIND_USER, LDAP_BIND_PASSWORD
# Используйте ldaps://; пароль bind не коммитьте.
LDAP_URI=ldaps://example.com
LDAP_BASE_DN=DC=example,DC=com
LDAP_DOMAIN=example.com
LDAP_BIND_USER=svc-s3fm
LDAP_BIND_PASSWORD=password
LDAP_SEARCH_SIZE_LIMIT=200
LDAP_SEARCH_TIME_LIMIT=5
